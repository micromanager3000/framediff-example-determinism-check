{
  "name": "@framediff/example-determinism-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Proves the library renders deterministically: each frame is rasterized twice via FrameDiff and SHA-256'd; equal hashes ⇒ same-machine determinism.",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run check"
  },
  "dependencies": {
    "framediff": "*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
